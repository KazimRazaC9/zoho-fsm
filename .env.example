# ---- Database ----
# App connection: non-owner role, row-level security applies.
DATABASE_URL="postgresql://fieldserve_app:fieldserve_app@localhost:5432/fieldserve?schema=public"
# Owner connection: used only by Prisma Migrate and the seed script.
DIRECT_DATABASE_URL="postgresql://fieldserve:fieldserve@localhost:5432/fieldserve?schema=public"

# ---- Auth ----
# Auth.js session secret (generate: npx auth secret, or openssl rand -base64 32)
AUTH_SECRET="replace-with-32+-random-characters"
AUTH_TRUST_HOST=true
# Signing key for bearer access tokens used by mobile clients (32+ chars)
JWT_SECRET="replace-with-another-32+-random-characters"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ---- Seed ----
# Password given to every demo user created by `pnpm db:seed`
SEED_PASSWORD="Demo@12345"

# ---- Email (Mailpit in dev: http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FieldServe <no-reply@fieldserve.local>"

# ---- Logging ----
LOG_LEVEL=info

# Attachments (photos, documents) are stored on local disk here (outside /public).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Photos are shrunk on the server, so the input limit is generous; videos recorded in the app are ~12 MB.
MAX_PHOTO_MB=25
MAX_VIDEO_MB=50
