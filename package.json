    "@types/node": "^20",
    "@types/pg": "8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "6.16.2",
    "tailwindcss": "^4",
    "tsx": "4.19.2",
    "tw-animate-css": "1.2.5",
